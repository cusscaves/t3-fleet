#!/bin/bash
# make-invite <machine-name>
# Prints a one-time invite code for someone joining your T3 fleet. Send it PRIVATELY (text/Signal).
# It bundles: machine name | Tailscale auth key | join webhook. Never post it publicly.
#
# Make the auth key at https://login.tailscale.com/admin/settings/keys :
#   Reusable ON (a Windows PC uses it twice: Windows + Linux) · Ephemeral off ·
#   Pre-approved ON · Tags: tag:friend · Expiry: 1 day
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
NAME="${1:-}"
[[ "$NAME" =~ ^[a-z0-9][a-z0-9-]{1,30}$ ]] || { echo "usage: make-invite <name>   e.g. make-invite jake-pc"; exit 2; }
WEBHOOK=$(cat ~/.config/fleet-watch/join-webhook)
read -rsp "Paste the Tailscale auth key (tskey-auth-...): " KEY; echo
[[ "$KEY" == tskey-auth-* ]] || { echo "That doesn't look like a tskey-auth-... key."; exit 2; }
CODE="T3FLEET-$(printf '%s|%s|%s' "$NAME" "$KEY" "$WEBHOOK" | base64 | tr -d '\n=' | tr '/+' '_-')"
echo "$(date '+%F %T') invited $NAME" >> "$HERE/issued.log"
cat <<EOF

Send these two things to them (the code privately):

  1. The guide: https://docs.google.com/document/d/1fh6q6QeG0WPY0TOQu4f9Ce5M67Fyj6ulQxyY9vzFZWE/edit?usp=sharing
  2. Their code (expires with the key, ~1 day):

$CODE

EOF
